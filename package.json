{
  "name": "transformer-summarizer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm --filter @summarizer/web build",
    "dev": "pnpm --filter @summarizer/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter @summarizer/web lint",
    "test": "pnpm --filter @summarizer/web test",
    "typecheck": "pnpm --filter @summarizer/web typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
